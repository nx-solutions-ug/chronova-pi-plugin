{
  "name": "@chronova/pi-plugin",
  "version": "1.7.7",
  "private": false,
  "description": "Chronova heartbeat tracking extension for oh-my-pi — sends coding activity to your Chronova dashboard via chronova-cli",
  "keywords": [
    "ai-coding",
    "chronova",
    "coding-analytics",
    "developer-analytics",
    "heartbeat",
    "oh-my-pi",
    "omp",
    "pi-plugin",
    "wakatime"
  ],
  "homepage": "https://github.com/nx-solutions-ug/chronova-pi-plugin#readme",
  "bugs": {
    "url": "https://github.com/nx-solutions-ug/chronova-pi-plugin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nx-solutions-ug/chronova-pi-plugin.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --packages external",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --react-plugin --vitest-plugin --import-plugin",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "semantic-release": "semantic-release",
    "prepublishOnly": "bun run type-check && bun run build",
    "lint:fix": "oxlint --react-plugin --vitest-plugin --import-plugin --fix",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "semantic-release": "^25.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
