{
  "name": "@chronova/pi-plugin",
  "version": "1.6.2",
  "description": "Chronova heartbeat tracking extension for oh-my-pi — sends coding activity to your Chronova dashboard via chronova-cli",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "private": false,
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chronova",
    "oh-my-pi",
    "omp",
    "pi-plugin",
    "wakatime",
    "heartbeat",
    "coding-analytics",
    "developer-analytics",
    "ai-coding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-solutions-ug/chronova-pi-plugin.git"
  },
  "homepage": "https://github.com/nx-solutions-ug/chronova-pi-plugin#readme",
  "bugs": {
    "url": "https://github.com/nx-solutions-ug/chronova-pi-plugin/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@oh-my-pi/pi-coding-agent": "^17.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "eslint": "^10.0.0",
    "semantic-release": "^25.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.61.1"
  }
}
